# Copier ce fichier en .env et renseigner les valeurs.
# .env est gitignoré — il ne doit JAMAIS être commité.

# --- TimescaleDB ---
POSTGRES_DB=oliveoil
POSTGRES_USER=oliveoil_app
POSTGRES_PASSWORD=change_me

# --- Broker MQTT (service d'ingestion) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=ingestion
MQTT_PASSWORD=change_me

# --- Device Simulator ---
SIMULATOR_MQTT_USERNAME=simulator
SIMULATOR_MQTT_PASSWORD=change_me
SIMULATOR_SITE_ID=warehouse-01
SIMULATOR_CONSIGNMENT_IDS=cons-001,cons-002
SIMULATOR_PUBLISH_INTERVAL=10
SIMULATOR_INCIDENT_PROBABILITY=0.005

# --- Moteur de qualité (toutes les valeurs ont des défauts raisonnables) ---
# QUALITY_TEMP_BASELINE=18.0        # °C — seuil au-dessus duquel l'exposition est comptée
# QUALITY_LIGHT_BASELINE=50.0       # lux — idem
# QUALITY_TEMP_WEIGHT=2.0           # points de qualité perdus par degré-heure
# QUALITY_LIGHT_WEIGHT=0.005        # points de qualité perdus par lux-heure (faible : incidents sun_exposure ne détruisent pas le score instantanément)
# QUALITY_ALERT_WARNING_SCORE=70.0  # score en dessous duquel alerte "warning"
# QUALITY_ALERT_CRITICAL_SCORE=50.0 # score en dessous duquel alerte "critical"
# QUALITY_TEMP_ALERT=30.0           # °C — alerte instantanée si dépassé
# QUALITY_LIGHT_ALERT=5000.0        # lux — alerte instantanée si dépassé
# QUALITY_HUMIDITY_ALERT=70.0       # % — alerte instantanée si dépassé
# QUALITY_ALERT_COOLDOWN=3600       # secondes entre deux alertes du même type
# QUALITY_RUN_INTERVAL=30           # secondes entre deux cycles du moteur
# QUALITY_WINDOW_DAYS=1             # fenêtre glissante en jours (0 = historique complet)

# --- API ---
API_AUTH_TOKEN=change_me

# --- Injecteur manuel ---
# Réutilise les credentials MQTT du simulateur (même rôle d'émetteur, ACL
# write-only). En production : identité MQTT dédiée. Le site et le token sont
# hérités des variables ci-dessus (SIMULATOR_SITE_ID, API_AUTH_TOKEN).
